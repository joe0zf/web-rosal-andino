---
import rosalAndinoLogo from '../../assets/logo-rosal-andino.svg';
export interface Props {
  class?: string
}

const { class: className = '' } = Astro.props
---

<div class={`tilt-wrapper mx-auto ${className}`} data-tilt-wrapper data-state="idle">
  <div
    class="tilt-card group relative w-[220px] aspect-[3/3] overflow-hidden rounded-2xl bg-transparent p-0 will-change-transform"
    data-tilt-card
  >
    {/* Contenido de la tarjeta */}
    <div class="relative z-10 flex h-full items-center justify-center text-center">
      <div class="metal-plate relative max-w-[320px]">
        {/* Capa base: el logo "grabado" en metal (con relieve, sin perder el color) */}
        <img
          src={rosalAndinoLogo.src}
          alt="logo"
          class="metal-plate-base block w-full transition-all duration-500"
        />

        {/* Capa de brillo, recortada (masked) a la silueta exacta del logo.
            Es el ÚNICO elemento que recibe el brillo ahora. */}
        <div
          class="metal-plate-sheen pointer-events-none absolute inset-0 transition-opacity duration-300"
          style={`-webkit-mask-image:url(${rosalAndinoLogo.src}); mask-image:url(${rosalAndinoLogo.src}); -webkit-mask-size:contain; mask-size:contain; -webkit-mask-repeat:no-repeat; mask-repeat:no-repeat; -webkit-mask-position:center; mask-position:center;`}
          data-metal-sheen
        >
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .tilt-wrapper {
    perspective: 900px;
  }

  .tilt-card {
    transform-style: preserve-3d;
    transform: rotateY(0deg) rotateX(0deg);
    transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* Mientras se está moviendo el puntero, transición corta para que
     siga al mouse sin "arrastre"; ver script para el toggle. */
  .tilt-card[data-tracking='true'] {
    transition: transform 0.08s linear;
  }

  /* --- Placa metálica --- */

  /* Giro continuo en reposo: como una moneda girando sobre su
     propio eje. Al ser CSS puro (no inline), funciona incluso antes
     de que cargue el script — y NO choca con el tilt: el tilt vive
     en .tilt-card (rotateX/rotateY, vía JS), el giro vive acá en
     .metal-plate (vía CSS) — son transforms anidados en elementos
     distintos, se combinan sin pisarse.

     OJO: un rotateZ "puro" siempre se ve plano, porque ese eje
     apunta directo a la cámara — la cara nunca deja de estar de
     frente, solo rota como una manecilla de reloj. Para que SE
     SIENTA 3D hay que verla desde un ángulo: por eso cada keyframe
     combina el giro (rotateZ, el que cambia) con una inclinación
     fija en X (rotateX(22deg), constante).

     El ORDEN importa: acá va rotateZ primero (izquierda) y rotateX
     después (derecha). En CSS, la transformación de más a la
     derecha se aplica primero sobre el objeto — así que primero se
     inclina 22° (rotateX, fijo) y RECIÉN DESPUÉS ese disco ya
     inclinado gira sobre el eje Z de la pantalla. El resultado es
     que la silueta elíptica completa "tumba" al girar (como una
     moneda real cayendo/girando), en vez de quedar una elipse fija
     con el dibujo rotando adentro (que se ve mucho más plano). */
  @keyframes spin-z {
    from {
      transform: rotate3d(0, 1, 0, 0deg);
    }

    to {
      transform: rotate3d(0, 1, 0, 360deg);
    }
  }

  .metal-plate {
    transform-style: preserve-3d;
    animation: spin-z 8s linear infinite;
  }

  /* En hover el giro se PAUSA (no se detiene en seco a 0°): queda
     congelado en el ángulo donde iba y retoma desde ahí al soltar. */
  .tilt-wrapper[data-state='hover'] .metal-plate {
    animation-play-state: paused;
  }

  /* Base: mantiene el color original del logo, solo le sube un poco
     el contraste/saturación y agrega un bisel con drop-shadow
     claro/oscuro para dar volumen, como si estuviera grabado en
     relieve sobre una placa esmaltada (sin quitarle el color). */
  .metal-plate-base {
    filter: saturate(1.15) contrast(1.1) brightness(1.02)
      drop-shadow(-1px -1px 0.5px rgba(255, 255, 255, 0.65))
      drop-shadow(1px 1px 0.5px rgba(0, 0, 0, 0.45));
  }

  /* Brillo tipo "foco": un círculo de luz centrado en la posición
     del puntero (--mx/--my, seteadas en JS sobre .tilt-card y
     heredadas por cascada), recortado a la silueta exacta del logo
     vía mask-image. mix-blend-mode: soft-light aporta el destello
     de "vidrio/esmalte" sin quemar el color a blanco. */
  .metal-plate-sheen {
    background: radial-gradient(
      circle 140px at var(--mx, 50%) var(--my, 50%),
      rgba(255, 255, 255, 0.95),
      rgba(255, 255, 255, 0.35) 45%,
      transparent 75%
    );
    mix-blend-mode: soft-light;
  }

  /* En reposo (sin mouse encima) el brillo queda en un punto FIJO,
     descentrado. Como quien gira es .metal-plate (padre de esta capa
     también), ese punto fijo "recorre" la superficie del logo solo,
     gracias al giro — no hace falta animar --mx/--my a mano. Esta
     regla, al estar declarada sobre el propio elemento, gana por
     sobre cualquier --mx/--my heredado desde .tilt-card. */
  .tilt-wrapper[data-state='idle'] .metal-plate-sheen {
    --mx: 28%;
    --my: 22%;
    opacity: 0.85;
  }
</style>

<script>
  function initTilt(wrapper: HTMLElement) {
    const card = wrapper.querySelector<HTMLElement>('[data-tilt-card]')
    const shineLayers = wrapper.querySelectorAll<HTMLElement>('[data-metal-sheen]')
    if (!card || shineLayers.length === 0) return

    let isTouching = false
    const MAX_TILT = 16 // grados máximos de inclinación

    const setShineOpacity = (value: number | null) => {
      shineLayers.forEach((layer) => {
        if (value === null) {
          layer.style.removeProperty('opacity')
        } else {
          layer.style.opacity = String(value)
        }
      })
    }

    const applyTilt = (clientX: number, clientY: number) => {
      const rect = card.getBoundingClientRect()
      const centerX = rect.left + rect.width / 2
      const centerY = rect.top + rect.height / 2

      const relX = (clientX - centerX) / (rect.width / 2)
      const relY = (clientY - centerY) / (rect.height / 2)

      const deltaX = Math.max(-1, Math.min(1, relX)) * MAX_TILT
      const deltaY = Math.max(-1, Math.min(1, relY)) * MAX_TILT

      card.style.transform = `rotateY(${deltaX}deg) rotateX(${-deltaY}deg)`

      const px = ((clientX - rect.left) / rect.width) * 100
      const py = ((clientY - rect.top) / rect.height) * 100

      const glareX = 100 - px
      const glareY = 100 - py

      card.style.setProperty('--mx', `${glareX}%`)
      card.style.setProperty('--my', `${glareY}%`)
    }

    const resetTilt = () => {
      card.dataset.tracking = 'false'
      card.style.transform = 'rotateY(0deg) rotateX(0deg)'
      wrapper.dataset.state = 'idle'
      // null = "sacar el opacity inline", para que vuelva a mandar
      // la regla CSS de reposo ([data-state='idle'] .metal-plate-sheen)
      // en vez de quedar pegado en el último valor que puso el hover.
      setShineOpacity(null)
    }

    card.addEventListener('mouseenter', () => {
      if (isTouching) return
      card.dataset.tracking = 'true'
      wrapper.dataset.state = 'hover'
      setShineOpacity(1)
    })

    card.addEventListener('mousemove', (event) => {
      if (isTouching) return
      applyTilt(event.clientX, event.clientY)
    })

    card.addEventListener('mouseleave', () => {
      if (isTouching) return
      resetTilt()
    })

    card.addEventListener(
      'touchstart',
      (event) => {
        isTouching = true
        card.dataset.tracking = 'true'
        wrapper.dataset.state = 'hover'
        setShineOpacity(1)
        const touch = event.touches[0]
        applyTilt(touch.clientX, touch.clientY)
      },
      { passive: true }
    )

    card.addEventListener(
      'touchmove',
      (event) => {
        if (!isTouching) return
        const touch = event.touches[0]
        applyTilt(touch.clientX, touch.clientY)
      },
      { passive: true }
    )

    card.addEventListener('touchend', () => {
      isTouching = false
      resetTilt()
    })
  }

  document.querySelectorAll<HTMLElement>('[data-tilt-wrapper]').forEach(initTilt)
</script>